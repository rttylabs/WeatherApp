@model WeatherApp.Models.WeatherViewModel
@{
    ViewData["Title"] = "Погода в Москве";
    var weatherIcon = Model?.Data?.Current?.Condition?.Icon ?? "";
    var iconUrl = !string.IsNullOrEmpty(weatherIcon) ? $"https:{weatherIcon}" : "";
}

<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=yes">
    <title>@ViewData["Title"]</title>
    <style>
            * {
                margin: 0;
                padding: 0;
                box-sizing: border-box;
            }

            body {
                font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
                background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
                min-height: 100vh;
                padding: 20px;
            }

            .container {
                max-width: 1200px;
                margin: 0 auto;
            }

            /* Загрузка */
            .loading-overlay {
                position: fixed;
                top: 0;
                left: 0;
                right: 0;
                bottom: 0;
                background: rgba(0, 0, 0, 0.7);
                display: flex;
                justify-content: center;
                align-items: center;
                z-index: 1000;
            }

            .spinner {
                width: 50px;
                height: 50px;
                border: 5px solid rgba(255, 255, 255, 0.3);
                border-radius: 50%;
                border-top-color: #fff;
                animation: spin 1s ease-in-out infinite;
            }

            @@keyframes spin {
                to {
                    transform: rotate(360deg);
                }
            }

            /* Ошибка */
            .error-container {
                background: white;
                border-radius: 20px;
                padding: 40px;
                text-align: center;
                max-width: 500px;
                margin: 100px auto;
                box-shadow: 0 10px 40px rgba(0,0,0,0.1);
            }

                .error-container h2 {
                    color: #e74c3c;
                    margin-bottom: 15px;
                }

                .error-container p {
                    color: #666;
                    margin-bottom: 25px;
                }

            .retry-btn {
                background: #667eea;
                color: white;
                border: none;
                padding: 12px 30px;
                border-radius: 25px;
                font-size: 16px;
                cursor: pointer;
                transition: transform 0.2s;
            }

                .retry-btn:hover {
                    transform: scale(1.05);
                }

            /* Карточки погоды */
            .weather-card {
                background: rgba(255, 255, 255, 0.95);
                border-radius: 20px;
                padding: 25px;
                margin-bottom: 20px;
                box-shadow: 0 5px 20px rgba(0,0,0,0.1);
            }

            .current-weather {
                display: grid;
                grid-template-columns: auto 1fr;
                gap: 30px;
                align-items: center;
            }

            .temp-section {
                text-align: center;
            }

            .temp {
                font-size: 64px;
                font-weight: bold;
                color: #333;
            }

            .feels-like {
                color: #666;
                margin-top: 5px;
            }

            .weather-icon img {
                width: 80px;
                height: 80px;
            }

            .weather-details {
                display: grid;
                grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
                gap: 15px;
            }

            .detail-item {
                text-align: center;
                padding: 10px;
                background: #f8f9fa;
                border-radius: 10px;
            }

            .detail-label {
                font-size: 12px;
                color: #666;
                margin-bottom: 5px;
            }

            .detail-value {
                font-size: 18px;
                font-weight: bold;
                color: #333;
            }

            /* Почасовой прогноз */
            .hourly-scroll {
                overflow-x: auto;
                display: flex;
                gap: 15px;
                padding: 10px 0;
            }

            .hour-card {
                flex: 0 0 auto;
                text-align: center;
                background: #f8f9fa;
                padding: 15px;
                border-radius: 10px;
                min-width: 80px;
            }

            .hour-time {
                font-size: 14px;
                font-weight: bold;
                color: #667eea;
            }

            .hour-temp {
                font-size: 20px;
                font-weight: bold;
                margin: 8px 0;
            }

            .hour-icon img {
                width: 40px;
                height: 40px;
            }

            .rain-chance {
                font-size: 12px;
                color: #3498db;
            }

            /* 3-дневный прогноз */
            .forecast-grid {
                display: grid;
                grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
                gap: 20px;
                margin-top: 20px;
            }

            .forecast-day {
                background: #f8f9fa;
                border-radius: 15px;
                padding: 20px;
                text-align: center;
            }

            .forecast-date {
                font-size: 18px;
                font-weight: bold;
                color: #667eea;
                margin-bottom: 10px;
            }

            .forecast-temp {
                font-size: 24px;
                font-weight: bold;
                margin: 10px 0;
            }

            .temp-range {
                color: #666;
                font-size: 14px;
            }

            .location-info {
                text-align: center;
                margin-bottom: 20px;
            }

            .city-name {
                font-size: 28px;
                font-weight: bold;
                color: white;
            }

            .city-country {
                color: rgba(255,255,255,0.9);
            }

            h2 {
                color: white;
                margin: 20px 0 15px 0;
            }

            @@media (max-width: 768px) {
                .current-weather {
                    grid-template-columns: 1fr;
                    gap: 20px;
                }
            
                .temp {
                    font-size: 48px;
                }
            
                .weather-details {
                    grid-template-columns: repeat(2, 1fr);
                }
            }
    </style>
</head>
<body>
    <div class="container">
        @if (Model?.IsLoading == true)
        {
            <div class="loading-overlay" id="loadingOverlay">
                <div class="spinner"></div>
            </div>
        }
        else if (Model?.HasError == true)
        {
            <div class="error-container">
                <h2>⚠️ Ошибка</h2>
                <p>@Model.ErrorMessage</p>
                <button class="retry-btn" onclick="refreshWeather()">🔄 Повторить запрос</button>
            </div>
        }
        else if (Model?.Data != null)
        {
            <div class="location-info">
                <div class="city-name">@Model.Data.Location?.Name</div>
                <div class="city-country">@Model.Data.Location?.Country</div>
                <div style="color: rgba(255,255,255,0.8); font-size: 14px;">
                    @DateTime.Parse(Model.Data.Location?.Localtime ?? DateTime.Now.ToString()).ToString("dd MMMM yyyy, HH:mm")
                </div>
            </div>

            <!-- Текущая погода -->
            <div class="weather-card">
                <div class="current-weather">
                    <div class="temp-section">
                        <div class="weather-icon">
                            @if (!string.IsNullOrEmpty(iconUrl))
                            {
                                <img src="@iconUrl" alt="@Model.Data.Current.Condition.Text">
                            }
                        </div>
                        <div class="temp">@Math.Round(Model.Data.Current.TempC)°C</div>
                        <div class="feels-like">Ощущается как @Math.Round(Model.Data.Current.FeelsLikeC)°C</div>
                        <div style="margin-top: 10px; color: #666;">@Model.Data.Current.Condition.Text</div>
                    </div>
                    <div class="weather-details">
                        <div class="detail-item">
                            <div class="detail-label">💧 Влажность</div>
                            <div class="detail-value">@Model.Data.Current.Humidity%</div>
                        </div>
                        <div class="detail-item">
                            <div class="detail-label">💨 Ветер</div>
                            <div class="detail-value">@Math.Round(Model.Data.Current.WindKph) км/ч</div>
                        </div>
                        <div class="detail-item">
                            <div class="detail-label">📊 Давление</div>
                            <div class="detail-value">@Math.Round(Model.Data.Current.PressureMb) мбар</div>
                        </div>
                        <div class="detail-item">
                            <div class="detail-label">☀️ УФ-индекс</div>
                            <div class="detail-value">@Math.Round(Model.Data.Current.Uv)</div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Почасовой прогноз -->
            @if (Model.HourlyForecast?.Any() == true)
            {
                <h2>📅 Почасовой прогноз</h2>
                <div class="weather-card">
                    <div class="hourly-scroll">
                        @foreach (var hour in Model.HourlyForecast.Take(24))
                        {
                            var hourTime = DateTime.Parse(hour.Time);
                            <div class="hour-card">
                                <div class="hour-time">@hourTime.ToString("HH:mm")</div>
                                <div class="hour-icon">
                                    @if (!string.IsNullOrEmpty(hour.Condition?.Icon))
                                    {
                                        <img src="https:@hour.Condition.Icon" alt="">
                                    }
                                </div>
                                <div class="hour-temp">@Math.Round(hour.TempC)°</div>
                                @if (hour.ChanceOfRain > 0)
                                {
                                    <div class="rain-chance">🌧️ @hour.ChanceOfRain%</div>
                                }
                            </div>
                        }
                    </div>
                </div>
            }

            <!-- Прогноз на 3 дня -->
            @if (Model.ThreeDayForecast?.Any() == true)
            {
                <h2>📆 Прогноз на 3 дня</h2>
                <div class="forecast-grid">
                    @foreach (var day in Model.ThreeDayForecast)
                    {
                        var date = DateTime.Parse(day.Date);
                        <div class="forecast-day">
                            <div class="forecast-date">@date.ToString("dd MMMM", new System.Globalization.CultureInfo("ru-RU"))</div>
                            <div class="forecast-icon">
                                @if (!string.IsNullOrEmpty(day.Day?.Condition?.Icon))
                                {
                                    <img src="https:@day.Day.Condition.Icon" alt="" style="width: 50px;">
                                }
                            </div>
                            <div class="forecast-temp">@Math.Round(day.Day.AvgTempC)°C</div>
                            <div class="temp-range">
                                ↑ @Math.Round(day.Day.MaxTempC)° ↓ @Math.Round(day.Day.MinTempC)°
                            </div>
                            <div style="margin-top: 10px; color: #666;">@day.Day.Condition.Text</div>
                            @if (day.Day.DailyChanceOfRain > 0)
                            {
                                <div style="margin-top: 8px; color: #3498db;">🌧️ Шанс дождя: @day.Day.DailyChanceOfRain%</div>
                            }
                            @if (day.Astro != null)
                            {
                                <div style="margin-top: 8px; font-size: 12px; color: #888;">
                                    🌅 @day.Astro.Sunrise | 🌇 @day.Astro.Sunset
                                </div>
                            }
                        </div>
                    }
                </div>
            }

            <div style="text-align: center; margin-top: 20px;">
                <button class="retry-btn" onclick="refreshWeather()">🔄 Обновить погоду</button>
            </div>
        }

        <script>
                    async function refreshWeather() {
                        const loadingDiv = document.createElement('div');
                        loadingDiv.className = 'loading-overlay';
                        loadingDiv.innerHTML = '<div class="spinner"></div>';
                        document.body.appendChild(loadingDiv);
                
                        try {
                            const response = await fetch('/Home/Refresh', {
                                method: 'POST',
                                headers: {
                                    'Content-Type': 'application/json'
                                }
                            });
                    
                            if (response.ok) {
                                location.reload();
                            } else {
                                alert('Ошибка при обновлении данных');
                                loadingDiv.remove();
                            }
                        } catch (error) {
                            alert('Ошибка сети');
                            loadingDiv.remove();
                        }
                    }
            
                    // Автоматическое обновление каждые 30 минут
                    setInterval(refreshWeather, 30 * 60 * 1000);
        </script>
    </div>
</body>
</html>